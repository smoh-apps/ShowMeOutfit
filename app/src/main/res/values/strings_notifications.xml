<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy owned by the morning notification (SMO-S3-03) and its rich expansion (SMO-S3-04).
  Kept in a dedicated file so it cannot conflict with other screens' string resources.
-->
<resources>

    <!-- Channel -->
    <string name="notification_channel_name">Morning outfit</string>
    <string name="notification_channel_description">Your daily layers and accessories, delivered at the time you choose.</string>

    <!-- Content -->
    <string name="notification_title">Morning outfit · %1$s–%2$s°</string>
    <string name="notification_layer_line">%1$s: %2$s</string>
    <string name="notification_layer_base">Base</string>
    <string name="notification_layer_mid">Mid</string>
    <string name="notification_layer_outer">Outer</string>
    <string name="notification_layer_bottom">Bottoms</string>
    <string name="notification_layer_footwear">Shoes</string>
    <string name="notification_accessories">Also bring: %1$s</string>
    <string name="notification_no_accessories">No extras needed today.</string>

    <!-- Highlights (SMO-S3-04). Arguments arrive pre-formatted, hence %s for numbers. -->
    <string name="notification_highlight_rain_window">Rain %1$s–%2$s. Umbrella in the bag.</string>
    <string name="notification_highlight_rain_chance">%1$s%% chance of rain. Umbrella in the bag.</string>
    <string name="notification_highlight_uv">UV %1$s. Sunglasses and sunscreen.</string>
    <string name="notification_highlight_uv_hat">UV %1$s. Sun hat, sunglasses and sunscreen.</string>
    <string name="notification_highlight_wind">Wind up to %1$s km/h. The windbreaker has you covered.</string>
    <string name="notification_highlight_swing">%1$s° drop later. Pack the evening layer.</string>

