<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Adaptive icon foreground (SMO-S4-06). Artwork: docs/design/branding/smo_app_icon_cat_tail.svg.

      The designer's 512x512 canvas is mapped onto the 108dp adaptive viewport at a 0.18 scale and
      centred on (54,54). The emblem's widest element is the orbit ring (r = 172 + 7 stroke half-width
      = 179 units), which lands at 32.2dp radius, i.e. a 64.4dp diameter that stays inside the 66dp
      adaptive-icon safe-zone circle, so no launcher mask can clip the linework.

      Nothing is filled here: the cream canvas is supplied by ic_launcher_background, and this layer
      carries only the indigo linework plus the terracotta sun dot.
    -->
    <group
        android:scaleX="0.18"
        android:scaleY="0.18"
        android:translateX="7.92"
        android:translateY="7.92">

        <!-- Outer orbit ring: 'O' for weather and the diurnal cycle -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 84,256 a 172,172 0 1,0 344,0 a 172,172 0 1,0 -344,0"
            android:strokeColor="#111827"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="14" />

        <!-- Coat hanger hook -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 256 160 C 256 138, 274 134, 274 146 C 274 156, 262 162, 256 172"
            android:strokeColor="#111827"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="14" />

        <!-- Hanger shoulders: 'M' for Mode and outfit layering -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 256 172 L 132 242 C 124 246, 126 256, 136 256 L 176 256 L 176 338"
            android:strokeColor="#111827"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="14" />
        <path
            android:fillColor="#00000000"
            android:pathData="M 256 172 L 380 242 C 388 246, 386 256, 376 256 L 336 256 L 336 338"
            android:strokeColor="#111827"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="14" />

        <!-- Blazer lapel V-neck -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 176 256 L 216 288 L 256 256 L 296 288 L 336 256"
            android:strokeColor="#111827"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="14" />

        <!-- 'S' as a graceful cat's tail -->
        <path
            android:fillColor="#00000000"
            android:pathData="M 224 232 C 196 238, 188 274, 226 296 C 276 324, 284 356, 256 386 C 230 412, 186 398, 178 368 C 174 354, 184 340, 196 342 C 206 344, 210 356, 214 366 C 222 384, 248 388, 262 374 C 278 358, 268 334, 236 316 C 188 290, 186 244, 224 224"
            android:strokeColor="#111827"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="16" />

        <!-- Terracotta sun accent dot -->
        <path
            android:fillColor="#E06D44"
            android:pathData="M 240,184 a 16,16 0 1,0 32,0 a 16,16 0 1,0 -32,0" />
    </group>
</vector>
